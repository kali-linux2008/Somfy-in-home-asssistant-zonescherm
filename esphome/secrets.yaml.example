# Kopieer dit bestand naar secrets.yaml en vul je eigen waarden in.
# secrets.yaml staat in .gitignore en wordt NIET gecommit.

wifi_ssid: "JouwWiFiNaam"
wifi_password: "JouwWiFiWachtwoord"

# Wachtwoord voor de fallback-accesspoint van het apparaat
ap_password: "minimaal8tekens"

# API encryptie-sleutel: genereer een nieuwe op https://esphome.io of laat
# de ESPHome dashboard er een aanmaken. 32-byte base64-string.
api_encryption_key: "VERVANG_DOOR_GEGENEREERDE_SLEUTEL"

# Wachtwoord voor over-the-air updates
ota_password: "kiesEenWachtwoord"
